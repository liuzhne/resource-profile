# Copy with: python3 scripts/cloud-deploy.py init-env
# Generated secrets are written only to ignored docker/.env.cloud (mode 0600).
# Supply a domain whose DNS points at the cloud VM before opening the public site.
CLOUD_SITE_ADDRESS=change-me.example.com
# Fill the created VM's public IPv4; publication checks DNS against this address.
CLOUD_PUBLIC_IP=change-me
# Private font is uploaded separately; relative paths resolve from docker/.
# Must be a genuine static Regular TTF, not an OTF renamed to .ttf.
CLOUD_EXPORT_FONT_FILE=../.local-run/cloud/fonts/NotoSansSC-Regular.ttf
MYSQL_USER=edu
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
REDIS_PASSWORD=change-me
JWT_SECRET=change-me
EDUCARE_INTERNAL_TOKEN=change-me
EDUCARE_MCP_TOKEN=change-me
EDUCARE_ADMIN_TOKEN=change-me
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me

# OpenAI-compatible chat provider: Java root and Python root + /v1.
# Do not use the sample endpoint or an unauthorised paid provider.
SPRING_AI_OPENAI_BASE_URL=https://change-me.example.com
LLM_BASE_URL=https://change-me.example.com/v1
LLM_API_KEY=change-me
LLM_MODEL=change-me
LLM_MAX_TOKENS=2048
# Provider-specific options: leave TEXT/empty for ordinary compatible endpoints.
# For Groq GPT-OSS-120B: JSON_OBJECT / low / LLM_MAX_TOKENS=2400,
# enable strict ReAct and shared provider policy below. No paid-plan upgrade.
# The 1200-token synthetic request also passed; production 400 root cause is not proven.
SPRING_AI_OPENAI_CHAT_OPTIONS_RESPONSE_FORMAT_TYPE=TEXT
SPRING_AI_OPENAI_CHAT_OPTIONS_REASONING_EFFORT=

# Independent embedding provider; use its real output dimension before creating collections.
EMBEDDING_BASE_URL=https://change-me.example.com/v1
EMBEDDING_API_KEY=change-me
EMBEDDING_MODEL=change-me
EMBEDDING_DIM=1024
RERANKER_ENABLED=false

# Optional tracing; empty does not count as R-5 trace acceptance.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Public console URL is baked into frontend assets at build time; rebuild/import the image after changes.
VITE_LANGFUSE_URL=https://jp.cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_ENABLED=true
LANGFUSE_CONNECT_TIMEOUT_MS=2000
LANGFUSE_READ_TIMEOUT_MS=5000

# Single application provider cooldown, bounded queue/retries and deadlines.
# For the existing Groq setup set REQUEST_POLICY_ENABLED and STRUCTURED_OUTPUT_ENABLED to true.
EDUCARE_LLM_REQUEST_POLICY_ENABLED=false
EDUCARE_LLM_SHARED_COOLDOWN_ENABLED=true
EDUCARE_LLM_REQUEST_QUEUE_CAPACITY=2
EDUCARE_LLM_REQUEST_MAX_WAIT_MS=180000
EDUCARE_LLM_MIN_REQUEST_INTERVAL_MS=60000
EDUCARE_LLM_RETRY_MAX_ATTEMPTS=3
EDUCARE_LLM_RETRY_MAX_DELAY_MS=120000
EDUCARE_LLM_MAX_OUTPUT_TOKENS=2400
EDUCARE_LLM_MAX_INPUT_CHARACTERS=18000
EDUCARE_AGENT_LOOP_STRUCTURED_OUTPUT_ENABLED=false
EDUCARE_AGENT_LOOP_DEADLINE_SECONDS=900
EDUCARE_AGENT_TASK_CONCURRENCY=1
EDUCARE_AGENT_TASK_QUEUE_CAPACITY=2
EDUCARE_AGENT_TASK_LOCK_SECONDS=1200
AI_INFERENCE_READ_TIMEOUT_MS=240000
