# ============================================================
# 生产密钥模板 —— 复制为 docker/.env 后逐项填强随机值
#   cp docker/.env.example docker/.env   然后编辑 docker/.env
# docker-compose 启动时自动读取同目录 docker/.env 覆盖所有 ${VAR}。
# docker/.env 已被 .gitignore 忽略，切勿提交真实密钥。
#
# 生成强随机值（任选）：
#   openssl rand -base64 32        # 通用 32 字节 Base64（适合 JWT/MCP/Nacos token）
#   openssl rand -hex 24           # 48 位十六进制（适合 MinIO/DB 密码）
#   pwgen -s 32 1                  # 若已装 pwgen
#
# 改完用 scripts/preflight-prod.sh 体检：任何项仍为 dev 默认/留空即 fail。
# ============================================================

# ---- MySQL ----
# root：仅 Nacos 元数据库 + 运维用；业务服务走下方 edu 账号
MYSQL_ROOT_PASSWORD=change-me-strong-root-pw
MYSQL_USER=edu
MYSQL_PASSWORD=change-me-strong-edu-pw

# ---- Nacos ----
# 控制台账号：除在此设置外，还须登录 Nacos(8848) 改掉默认 nacos/nacos 账号本身
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me-strong-nacos-pw
# 服务端身份 token：必须 Base64 且解码后 ≥ 32 字节（openssl rand -base64 48）
NACOS_AUTH_TOKEN=change-me-base64-at-least-32-bytes-decoded
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=change-me-identity-value

# ---- MinIO（Milvus 对象存储）----
MINIO_ACCESS_KEY=change-me-minio-access
MINIO_SECRET_KEY=change-me-minio-secret

# ---- Redis ----
# 生产硬门：至少 32 字符；compose 会据此启用 redis --requirepass 并下发全部消费者
REDIS_PASSWORD=change-me-strong-redis-pw

# ---- JWT（业务鉴权，HS256）----
# 必须 ≥ 32 字符，否则 JwtUtil 启动即 fail-fast。openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-chars-strong-secret

# ---- MCP 内部预共享 token（agent-service ↔ MCP server 互验）----
# 生产硬门：至少 32 字符；agent-service 与两个 MCP server 必须同值
EDUCARE_MCP_TOKEN=change-me-mcp-shared-token

# ---- Langfuse（可选，LLM trace；仅 `--profile langfuse` 时需要）----
LANGFUSE_DB_PASSWORD=change-me-langfuse-db-pw
LANGFUSE_NEXTAUTH_SECRET=change-me-openssl-rand-base64-32
LANGFUSE_SALT=change-me-openssl-rand-base64-32
LANGFUSE_PUBLIC_URL=http://localhost:3001
# 由 Langfuse 控制台创建 project 后获得，配回各 service（agent-service LANGFUSE_*）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- Grafana（可选，监控栈；仅 `--profile monitoring` 时需要）----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-pw
