# Set CLOUD_SITE_ADDRESS to a hostname whose DNS points at this VM.
# Caddy obtains/renews TLS certificates and redirects HTTP to HTTPS automatically.
# No HTTP-only site default: login should be opened only after TLS validation.
{$CLOUD_SITE_ADDRESS} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
	}

	# Do not publish operational metrics or internal control routes through /api.
	@private path /api/actuator /api/actuator/* /api/_internal /api/_internal/* /api/*/_internal/*
	handle @private {
		respond "Forbidden" 403
	}

	# Strip /api like the local Vite proxy. Streaming flushes immediately for SSE.
	handle_path /api/* {
		reverse_proxy gateway:8080 {
			flush_interval -1
			transport http {
				dial_timeout 5s
				read_timeout 3600s
			}
		}
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
