{
  "mysql": {
    "image": "mysql:8.0",
    "environment": {
      "MYSQL_ROOT_PASSWORD": "${MYSQL_ROOT_PASSWORD:?Set a fresh MYSQL_ROOT_PASSWORD}",
      "MYSQL_DATABASE": "edu_portrait",
      "MYSQL_USER": "${MYSQL_USER:-edu}",
      "MYSQL_PASSWORD": "${MYSQL_PASSWORD:?Set a fresh MYSQL_PASSWORD}",
      "TZ": "Asia/Shanghai"
    },
    "ports": [
      3306
    ],
    "requests": {
      "cpu": "200m",
      "memory": "512Mi"
    },
    "limitMemory": "1Gi",
    "volumes": [
      {
        "name": "mysql-data",
        "mountPath": "/var/lib/mysql",
        "size": "10Gi"
      }
    ],
    "args": [
      "--default-authentication-plugin=mysql_native_password",
      "--character-set-server=utf8mb4",
      "--collation-server=utf8mb4_unicode_ci",
      "--innodb-buffer-pool-size=256M",
      "--max-connections=100"
    ],
    "healthcheck": [
      "CMD-SHELL",
      "MYSQL_PWD=\"$$MYSQL_ROOT_PASSWORD\" mysql -h 127.0.0.1 -u root -e 'SELECT 1' >/dev/null"
    ]
  },
  "redis": {
    "image": "redis:7-alpine",
    "environment": {
      "REDIS_PASSWORD": "${REDIS_PASSWORD:?Set a fresh REDIS_PASSWORD}"
    },
    "ports": [
      6379
    ],
    "requests": {
      "cpu": "50m",
      "memory": "128Mi"
    },
    "limitMemory": "384Mi",
    "volumes": [
      {
        "name": "redis-data",
        "mountPath": "/data",
        "size": "2Gi"
      }
    ],
    "args": [
      "sh",
      "-c",
      "exec redis-server --requirepass \"$$REDIS_PASSWORD\" --appendonly yes --maxmemory 256mb --maxmemory-policy noeviction"
    ],
    "healthcheck": [
      "CMD-SHELL",
      "REDISCLI_AUTH=\"$$REDIS_PASSWORD\" redis-cli ping | grep -q PONG"
    ]
  },
  "etcd": {
    "image": "quay.io/coreos/etcd:v3.5.5",
    "environment": {
      "ETCD_AUTO_COMPACTION_MODE": "revision",
      "ETCD_AUTO_COMPACTION_RETENTION": "1000",
      "ETCD_QUOTA_BACKEND_BYTES": "4294967296",
      "ETCD_SNAPSHOT_COUNT": "50000"
    },
    "ports": [
      2379
    ],
    "requests": {
      "cpu": "50m",
      "memory": "128Mi"
    },
    "limitMemory": "512Mi",
    "volumes": [
      {
        "name": "etcd-data",
        "mountPath": "/etcd",
        "size": "5Gi"
      }
    ],
    "args": [
      "etcd",
      "--advertise-client-urls=http://etcd:2379",
      "--listen-client-urls=http://0.0.0.0:2379",
      "--data-dir=/etcd"
    ],
    "healthcheck": [
      "CMD",
      "etcdctl",
      "endpoint",
      "health"
    ]
  },
  "minio": {
    "image": "milvusdb/minio:RELEASE.2024-12-18T13-15-44Z",
    "environment": {
      "MINIO_ROOT_USER": "${MINIO_ACCESS_KEY:?Set a fresh MinIO access ID}",
      "MINIO_ROOT_PASSWORD": "${MINIO_SECRET_KEY:?Set a fresh MinIO secret}"
    },
    "ports": [
      9000,
      9001
    ],
    "requests": {
      "cpu": "50m",
      "memory": "128Mi"
    },
    "limitMemory": "512Mi",
    "volumes": [
      {
        "name": "minio-data",
        "mountPath": "/data",
        "size": "10Gi"
      }
    ],
    "args": [
      "server",
      "/data",
      "--console-address",
      ":9001"
    ],
    "healthcheck": [
      "CMD",
      "curl",
      "-fsS",
      "http://127.0.0.1:9000/minio/health/live"
    ]
  },
  "milvus-standalone": {
    "image": "milvusdb/milvus:v2.4.1",
    "environment": {
      "ETCD_ENDPOINTS": "etcd:2379",
      "MINIO_ADDRESS": "minio:9000"
    },
    "ports": [
      19530,
      9091
    ],
    "requests": {
      "cpu": "250m",
      "memory": "4Gi"
    },
    "limitMemory": "8Gi",
    "volumes": [
      {
        "name": "milvus-data",
        "mountPath": "/var/lib/milvus",
        "size": "15Gi"
      }
    ],
    "args": [
      "milvus",
      "run",
      "standalone"
    ],
    "healthcheck": [
      "CMD",
      "curl",
      "-fsS",
      "http://127.0.0.1:9091/healthz"
    ]
  },
  "auth-service": {
    "image": "edu-portrait-kamatera-auth-service:latest",
    "environment": {
      "SPRING_PROFILES_ACTIVE": "prod",
      "SPRING_CLOUD_NACOS_DISCOVERY_ENABLED": "false",
      "SPRING_CLOUD_NACOS_DISCOVERY_REGISTER_ENABLED": "false",
      "SPRING_CLOUD_NACOS_CONFIG_ENABLED": "false",
      "SPRING_CLOUD_NACOS_CONFIG_IMPORT_CHECK_ENABLED": "false",
      "SPRING_CONFIG_IMPORT": "optional:classpath:application.yml",
      "SPRING_MAIN_LAZY_INITIALIZATION": "false",
      "SPRING_MVC_SERVLET_LOAD_ON_STARTUP": "1",
      "EDUCARE_PERFORMANCE_DATABASE_WARMUP": "true",
      "MYBATIS_PLUS_CONFIGURATION_LOG_IMPL": "org.apache.ibatis.logging.nologging.NoLoggingImpl",
      "SERVER_COMPRESSION_ENABLED": "true",
      "MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED": "true",
      "MYSQL_HOST": "mysql",
      "MYSQL_PORT": "3306",
      "MYSQL_DATABASE": "edu_portrait",
      "MYSQL_USER": "${MYSQL_USER:-edu}",
      "MYSQL_PASSWORD": "${MYSQL_PASSWORD:?Set a fresh MYSQL_PASSWORD}",
      "MYSQL_SSL_MODE": "${MYSQL_SSL_MODE:-PREFERRED}",
      "DB_MAXIMUM_POOL_SIZE": "3",
      "DB_MINIMUM_IDLE": "1",
      "REDIS_HOST": "redis",
      "REDIS_PORT": "6379",
      "REDIS_PASSWORD": "${REDIS_PASSWORD:?Set a fresh REDIS_PASSWORD}",
      "SPRING_DATA_REDIS_HOST": "redis",
      "SPRING_DATA_REDIS_PORT": "6379",
      "SPRING_DATA_REDIS_PASSWORD": "${REDIS_PASSWORD:?Set a fresh REDIS_PASSWORD}",
      "SPRING_DATA_REDIS_DATABASE": "0",
      "JWT_SECRET": "${JWT_SECRET:?Set a fresh JWT_SECRET of at least 32 characters}",
      "EDUCARE_INTERNAL_TOKEN": "${EDUCARE_INTERNAL_TOKEN:?Set a fresh internal credential}",
      "EDUCARE_MCP_TOKEN": "${EDUCARE_MCP_TOKEN:?Set a fresh MCP credential}",
      "JAVA_TOOL_OPTIONS": "-XX:MaxRAMPercentage=65.0 -XX:+UseSerialGC -Djava.security.egd=file:/dev/./urandom",
      "PORT": "8081"
    },
    "ports": [
      8081
    ],
    "requests": {
      "cpu": "100m",
      "memory": "384Mi"
    },
    "limitMemory": "512Mi",
    "volumes": [],
    "healthcheck": [
      "CMD-SHELL",
      "curl -fsS http://127.0.0.1:$${PORT}/actuator/health >/dev/null"
    ]
  },
